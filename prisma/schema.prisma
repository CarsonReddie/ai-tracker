generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  password      String?
  accounts      Account[]
  sessions      Session[]
  providers     Provider[]
  requests      Request[]
  budgets       Budget[]
  hazardRule    HazardRule?
  createdAt     DateTime  @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Provider {
  id        String    @id @default(cuid())
  userId    String
  name      String
  apiKey    String
  isActive  Boolean   @default(true)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  requests  Request[]
  createdAt DateTime  @default(now())

  @@unique([userId, name])
}

model Request {
  id               String   @id @default(cuid())
  userId           String
  providerId       String
  model            String
  promptTokens     Int
  completionTokens Int
  totalTokens      Int
  cost             Float
  promptPreview    String?
  responsePreview  String?
  timestamp        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider         Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
}

model Budget {
  id             String   @id @default(cuid())
  userId         String
  monthlyLimit   Float
  alertThreshold Float    @default(0.8)
  provider       String?
  isActive       Boolean  @default(true)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
}

model HazardRule {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Runaway / loop detection (rolling 5 minute window)
  runawayEnabled     Boolean @default(true)
  runawayMaxRequests Int     @default(50)
  runawayMaxTokens   Int     @default(500000)

  // High-cost single requests
  highCostEnabled   Boolean @default(true)
  highCostThreshold Float   @default(1.0)

  // Unusual spikes vs baseline (hourly usage vs trailing average)
  spikeEnabled Boolean @default(true)
  spikeFactor  Float   @default(3.0)
}
